# ── Dependencies ──────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── Production & Build Outputs ────────────────────────────────────
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo
node_modules/.tmp/

# ── Documentation ─────────────────────────────────────────────────
docs/
*.doc
*.docx
*.pdf

# ── Environment & Secret Keys (ALWAYS PROTECTED) ─────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
*.pem
*.key

# Preserve example environment template
!.env.example

# ── Certificates: Allow webp preview images, NEVER push pdfs ─────
!public/certificates/
!public/certificates/*.webp
!public/certificates/.gitkeep
public/certificates/*.pdf

# ── Logs & Debugging ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage ────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Hosting & Tooling Caches ──────────────────────────────────────
.vercel
.turbo/
.cache/

# ── IDE & Editor Settings ─────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Operating System Junk ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
*~
*.tmp
*.temp
*.bak
